  "faq": {
    "titlePart1": "Frequently",
    "titlePart2": "Asked Questions",
    "description": "Answers to the most common questions about our services",
    "q1": {
      "question": "What documents are required for booking?",
      "answer": "You need a valid driver's license, valid ID/residency, and a credit card for guarantee."
    },
    "q2": {
      "question": "Can I return the car in a different city?",
      "answer": "Yes, we offer inter-city delivery service. Please contact us to arrange this with a small additional fee."
    },
    "q3": {
      "question": "What is the cancellation policy?",
      "answer": "You can cancel 24 hours before pickup without charges. After that, cancellation fees may apply."
    },
    "q4": {
      "question": "Is insurance included?",
      "answer": "Yes, all our cars are comprehensively insured. You can upgrade for broader coverage when booking."
    },
    "q5": {
      "question": "What is the minimum rental age?",
      "answer": "The minimum age is 21 years with a valid driver's license for at least one year."
    },
    "q6": {
      "question": "Can I add an additional driver?",
      "answer": "Yes, you can add an additional driver by providing their driver's license with a small extra fee."
    },
    "q7": {
      "question": "What should I do in case of accident or breakdown?",
      "answer": "Call us immediately on the emergency number. Our team is available 24/7 to assist you and send a replacement car."
    },
    "q8": {
      "question": "Can I extend the rental period?",
      "answer": "Yes, you can extend through the app or by calling us before the original period ends."
    }
  },
